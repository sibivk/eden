# Moviedarr Configuration
# Copy this file to .env and fill in your values

# Web server port
PORT=5000

# Primary NZB indexer (Newznab-compatible: NZBGeek, NZBFinder, DogNZB, etc.)
NZB_SEARCH_URL=https://api.nzbgeek.info/api
NZB_SEARCH_KEY=your_indexer_api_key_here

# Backup NZB indexer — tried when primary returns nothing (optional)
NZB_SEARCH_URL2=
NZB_SEARCH_KEY2=

# NZBGet connection
# Use host.containers.internal (not localhost) to reach services on the host from inside the container
NZBGET_URL=http://host.containers.internal:6789
NZBGET_USERNAME=nzbget
NZBGET_PASSWORD=your_nzbget_password

# Category assigned to queued downloads in NZBGet
NZB_CATEGORY=Evaluate

# Maximum NZB file size in GB (results above this are hidden)
MAX_SIZE_GB=10

# Path to your NAS media folder (mounted into container at /media)
STORAGE_PATH=/path/to/your/nas/media

# Language library paths — where completed downloads are moved and renamed
# These are mounted into the container at /libraries/{language}
SEARCH_MALAYALAM=/path/to/your/malayalam/library
SEARCH_HINDI=/path/to/your/hindi/library
SEARCH_TAMIL=/path/to/your/tamil/library
